{
  "name": "@appforge/llm-bridge",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local Node/Bun service that connects AppForge-LLM v6 to many external LLM providers, reusing the coco @opencode-ai/llm engine.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/llm": "file:./vendor/llm",
    "effect": "4.0.0-beta.74",
    "@smithy/eventstream-codec": "4.2.14",
    "@smithy/util-utf8": "4.2.2",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  }
}
