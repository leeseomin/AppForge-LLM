{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "system_context",
    "components",
    "data_flows",
    "technology_choices",
    "security_boundaries",
    "deployment_topology",
    "tradeoffs",
    "architecture_decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "system_context": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "responsibility",
          "interfaces"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "interfaces": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "technology_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "choice",
          "reason",
          "alternatives"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "security_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "deployment_topology": {
      "type": "string",
      "minLength": 1
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "architecture_decisions": {
      "type": "array",
      "items": {},
      "minItems": 0
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge architecture_spec"
}
