{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "loops",
    "retry_budget",
    "convergence",
    "human_escape_hatches",
    "observability",
    "tests",
    "traceability"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "entry_conditions",
          "exit_conditions",
          "guardrails",
          "max_iterations",
          "feedback_signal",
          "state_updates",
          "failure_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "entry_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exit_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1
          },
          "feedback_signal": {
            "type": "string",
            "minLength": 1
          },
          "state_updates": {
            "type": "string",
            "minLength": 1
          },
          "failure_policy": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "retry_budget": {
      "type": "string",
      "minLength": 1
    },
    "convergence": {
      "type": "string",
      "minLength": 1
    },
    "human_escape_hatches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "observability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workflow_step",
          "loop"
        ],
        "properties": {
          "workflow_step": {
            "type": "string",
            "minLength": 1
          },
          "loop": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge loop_spec"
}
