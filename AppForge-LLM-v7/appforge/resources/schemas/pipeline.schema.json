{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAppForge Pipeline Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "category",
    "description",
    "match",
    "orchestration",
    "stages"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "match": {
      "type": "object",
      "required": [
        "keywords"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "required": [
        "default_mode",
        "max_stage_attempts"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "autonomous",
            "guided"
          ]
        },
        "max_stage_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "skill",
          "produces",
          "review_focus",
          "success_criteria"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "skill": {
            "type": "string",
            "pattern": "^stages/[a-z0-9-]+\\.md$"
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "minItems": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkpoint": {
            "type": "boolean"
          },
          "approval": {
            "type": "boolean"
          },
          "review_focus": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "inputs": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
