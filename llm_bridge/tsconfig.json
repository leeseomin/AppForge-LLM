{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "lib": ["ESNext"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "vendor/llm/**/*.ts"]
}
