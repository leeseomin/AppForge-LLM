{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "passed",
    "original_failure_test",
    "test_commands",
    "results",
    "adjacent_regressions",
    "failures",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "original_failure_test": {
      "type": "string",
      "minLength": 1
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "passed",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "adjacent_regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge regression_report"
}
