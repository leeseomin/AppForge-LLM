{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "passed",
    "test_commands",
    "results",
    "acceptance_results",
    "coverage",
    "failures",
    "manual_checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "passed",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": [
              "boolean",
              "string"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^exec-[a-f0-9]{32}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "acceptance_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "passed",
          "evidence"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": [
              "boolean",
              "string"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^exec-[a-f0-9]{32}$"
            },
            "uniqueItems": true
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "coverage": {
      "type": "string",
      "minLength": 1
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "manual_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "execution_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^exec-[a-f0-9]{32}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge verification_report",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "required": [
          "execution_ids"
        ],
        "properties": {
          "results": {
            "items": {
              "required": [
                "evidence_ids"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                }
              }
            }
          },
          "acceptance_results": {
            "items": {
              "required": [
                "evidence_ids",
                "criterion_id"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  ]
}
