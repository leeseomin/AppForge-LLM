{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "OpenAppForge engineering_spec",
  "required": [
    "schema_version",
    "summary",
    "requirements",
    "screens",
    "state_and_data",
    "implementation_plan",
    "verification_plan",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "states"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "state_and_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_of_truth",
          "lifecycle"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_of_truth": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "implementation_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_profile": {
      "enum": [
        "static-web",
        "javascript-web",
        "typescript-web"
      ],
      "description": "Required for web pipelines; fixed before implementation."
    },
    "browser_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "actions",
          "assertions"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "path": {
            "type": "string",
            "pattern": "^/[^:]*$",
            "maxLength": 500
          },
          "actions": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "selector"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "click",
                    "fill",
                    "press",
                    "check",
                    "select"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "value": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "selector"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "visible",
                    "hidden",
                    "text",
                    "value",
                    "count"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "expected": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "maxLength": 2000
                }
              }
            }
          }
        }
      },
      "description": "Required for web pipelines: one host-run case per requirement acceptance item; IDs use REQ-ID/AC-01, AC-02, etc. Keep selectors part of the implementation contract."
    }
  },
  "additionalProperties": true
}
