{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "personas",
    "journeys",
    "screens_or_surfaces",
    "interaction_rules",
    "accessibility",
    "responsive_behavior",
    "content_guidelines"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "steps",
          "success_state"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "success_state": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "screens_or_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "states"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "interaction_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "responsive_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "content_guidelines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge experience_spec"
}
