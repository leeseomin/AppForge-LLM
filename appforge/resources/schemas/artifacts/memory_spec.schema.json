{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "summary",
    "memory_surfaces",
    "state_ownership",
    "retention",
    "serialization",
    "privacy",
    "reconciliation",
    "observability",
    "tests",
    "traceability"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "memory_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "scope",
          "lifetime",
          "source_of_truth"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "lifetime": {
            "type": "string",
            "minLength": 1
          },
          "source_of_truth": {
            "type": "string",
            "minLength": 1
          },
          "invalidated_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "state_ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state",
          "owner",
          "writers",
          "readers"
        ],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "writers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "retention": {
      "type": "string",
      "minLength": 1
    },
    "serialization": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "reconciliation": {
      "type": "string",
      "minLength": 1
    },
    "observability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "memory_surface"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "memory_surface": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "title": "OpenAppForge memory_spec"
}
